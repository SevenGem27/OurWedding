{
  // Configurazione Cloudflare: un solo Worker serve l'app e la sincronizzazione.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ourwedding",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // Il piano gratuito supporta solo Durable Objects con archivio SQLite
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true }
}
